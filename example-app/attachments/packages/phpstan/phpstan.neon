# =============================================================================
# КОНФИГУРАЦИЯ PHPSTAN
# =============================================================================
# Этот файл настраивает статический анализ PHP-кода
# =============================================================================

parameters:

    # =========================================================================
    # УРОВЕНЬ АНАЛИЗА
    # =========================================================================
    
    # Уровень строгости анализа (0-9 или max)
    # 0 - минимальный, 9 - очень строгий, max - максимальный
    level: 5

    # =========================================================================
    # ПУТИ ДЛЯ АНАЛИЗА
    # =========================================================================

    # Директории с кодом для анализа
    # Указываем только кастомный код, исключая системные папки
    paths:
        - local/src

    # =========================================================================
    # ИСКЛЮЧЕНИЯ
    # =========================================================================

    # Директории, которые нужно пропустить при анализе
    # Системные папки и сторонние библиотеки
    excludePaths:
        - vendor
        - upload

    # =========================================================================
    # АВТОЗАГРУЗКА
    # =========================================================================

    # Файлы для загрузки перед анализом
    # Необходимы для корректной работы с Bitrix API
    bootstrapFiles:
        - phpstan-bitrix-bootstrap.php

    # =========================================================================
    # ДОПОЛНИТЕЛЬНОЕ СКАНИРОВАНИЕ
    # =========================================================================

    # Дополнительные директории для сканирования классов
    # Позволяет PHPStan находить классы Bitrix
    scanDirectories:
        - bitrix/modules

    # =========================================================================
    # УНИВЕРСАЛЬНЫЕ ОБЪЕКТЫ
    # =========================================================================

    # Классы, которые считаются универсальными объектами
    # Позволяет обращаться к динамическим свойствам
    universalObjectCratesClasses:
        - CIBlockElement
        - CIBlockSection
        - CFile
        - CDBResult

    # =========================================================================
    # ИГНОРИРОВАНИЕ ОШИБОК
    # =========================================================================

    # Специфические ошибки, которые нужно игнорировать
    # Необходимо для работы с Bitrix API
    ignoreErrors:
        # Игнорируем ошибки вызова методов, которые есть в Bitrix, но неизвестны PHPStan
        - '#Call to an undefined method .*::GetNext\(\)#'
        - '#Call to an undefined method .*::Fetch\(\)#'
        - '#Access to an undefined property .*::\$[a-zA-Z_]+#'
        - '#Method .*::GetList\(\) invoked with \d+ parameters, 2-4 required#'

    # =========================================================================
    # НАСТРОЙКИ ОТЧЕТОВ
    # =========================================================================

    # reportUnmatchedIgnoredErrors - сообщать о неиспользуемых игнорированиях
    # false - не сообщать
    reportUnmatchedIgnoredErrors: false

    # =========================================================================
    # ДОПОЛНИТЕЛЬНЫЕ НАСТРОЙКИ
    # =========================================================================

    # tmpDir - временная директория для кэша
    tmpDir: bitrix/cache/phpstan

    # parallel - параллельная обработка
    # Ускоряет выполнение на многоядерных процессорах
    parallel:
        maximumNumberOfProcesses: 4
        processTimeout: 60.0
        minimumNumberOfJobsPerProcess: 2
        buffer: 134217728

    # treatPhpDocTypesAsCertain - считать типы из PHPDoc достоверными
    # false - не считать
    treatPhpDocTypesAsCertain: false